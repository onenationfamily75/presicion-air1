// ─── SEAT MAP ───
function buildSeatMap(){
  const map = document.getElementById('seatMap');
  map.innerHTML = '';
  selectedSeats = [];
  // 3 rows Business (1-3) + 15 rows Economy (4-18)
  for(let row=1; row<=18; row++){
    const isBiz = row <= 3;
    const div = document.createElement('div');
    div.className = 'seat-row';
    const rn = document.createElement('div');
    rn.className = 'row-num';
    rn.textContent = row;
    div.appendChild(rn);
    ['A','B'].forEach(col => {
      const seatNum = (row-1)*4 + (col==='A'?1:2);
      const occ = OCCUPIED.includes(seatNum);
      const s = document.createElement('div');
      s.className = `seat${isBiz?' biz':''}${occ?' occ':''}`;
      s.textContent = col;
      s.dataset.seat = `${row}${col}`;
      s.dataset.biz = isBiz;
      if(!occ) s.onclick = () => toggleSeat(s, `${row}${col}`);
      div.appendChild(s);
    });
    const aisle = document.createElement('div'); aisle.className='aisle'; div.appendChild(aisle);
    ['C','D'].forEach(col => {
      const seatNum = (row-1)*4 + (col==='C'?3:4);
      const occ = OCCUPIED.includes(seatNum);
      const s = document.createElement('div');
      s.className = `seat${isBiz?' biz':''}${occ?' occ':''}`;
      s.textContent = col;
      s.dataset.seat = `${row}${col}`;
      s.dataset.biz = isBiz;
      if(!occ) s.onclick = () => toggleSeat(s, `${row}${col}`);
      div.appendChild(s);
    });
    map.appendChild(div);
  }
  updateSeatNote();
}

function toggleSeat(el, id){
  if(el.classList.contains('sel')){
    el.classList.remove('sel');
    selectedSeats = selectedSeats.filter(s => s!==id);
  } else {
    if(selectedSeats.length >= modalPaxCount){ showToast(`Select exactly ${modalPaxCount} seat(s).`); return; }
    el.classList.add('sel');
    selectedSeats.push(id);
  }
  updateSeatNote();
}

function updateSeatNote(){
  document.getElementById('seatsNeeded').textContent = modalPaxCount;
  document.getElementById('seatsSelected').textContent = selectedSeats.length;
}

