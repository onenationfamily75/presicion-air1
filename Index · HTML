// occupied seats (random)
const OCCUPIED = [3,7,11,15,18,22,26,30,33,37,42,47];

// ─── STATE ───
let tripType = 'ow';
let paxCount = 1;
let currentRoute = null;
let selectedClass = 'eco';
let selectedSeats = [];
let passengers = [];
let currentStep = 1;

// ─── FORMAT ───
const fmt = (usd) => `USD ${usd.toFixed(0)}`;
const fmtTZS = (usd) => `TZS ${(usd * TZS_RATE).toLocaleString()}`;

// ─── TRIP TOGGLE ───
function setTrip(t){
  tripType = t;
  document.getElementById('owBtn').classList.toggle('active', t==='ow');
  document.getElementById('rtBtn').classList.toggle('active', t==='rt');
  document.getElementById('retDateWrap').style.display = t==='rt' ? 'flex' : 'none';
  if(t==='rt') document.getElementById('dateRow').style.gridTemplateColumns='1fr 1fr';
  else document.getElementById('dateRow').style.gridTemplateColumns='1fr 1fr';
