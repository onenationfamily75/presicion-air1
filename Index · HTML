<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Precision Air — Tanzania's Leading Airline</title>
<meta name="description" content="Book direct flights with Precision Air across Tanzania and East Africa. Fly to Zanzibar, Kilimanjaro, Nairobi, Mwanza and more. Economy & Business Class from USD 89."/>
<link rel="canonical" href="https://precisionairtz.site/"/>
<link rel="sitemap" type="application/xml" href="/sitemap.xml"/>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300&display=swap" rel="stylesheet"/>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --red:#c0392b;--red2:#e74c3c;--red-dark:#96281b;
  --navy:#0d1b2a;--navy2:#1a2e45;--navy3:#263d56;
  --gold:#f0a500;--gold2:#f7c948;
  --white:#fff;--off:#f8f9fb;--gray:#f1f3f6;
  --border:#e3e7ee;--mid:#6b7787;--text:#1a2332;
  --green:#27ae60;--wa:#25D366;
  --serif:'Syne',sans-serif;--sans:'DM Sans',sans-serif;
  --ex:2590; /* TZS per USD */
}
body{font-family:var(--sans);background:var(--white);color:var(--text);line-height:1.6;font-size:15px}
a{text-decoration:none;color:inherit}
img{display:block;max-width:100%}
button{cursor:pointer;font-family:var(--sans)}
input,select{font-family:var(--sans)}

/* ── TOPBAR ── */
.topbar{background:var(--navy);color:rgba(255,255,255,.75);font-size:.75rem;padding:.45rem 2rem;display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}
.topbar a{color:var(--gold2);transition:.15s}.topbar a:hover{color:#fff}
.tb-left,.tb-right{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap}

/* ── HEADER ── */
header{background:var(--white);border-bottom:2px solid var(--border);position:sticky;top:0;z-index:400;box-shadow:0 2px 16px rgba(0,0,0,.07)}
.hdr{max-width:1320px;margin:0 auto;padding:.9rem 2rem;display:flex;align-items:center;gap:2rem}
.logo{display:flex;align-items:center;gap:.8rem;flex-shrink:0}
.logo-mark{background:var(--red);color:#fff;font-family:var(--serif);font-size:1.1rem;font-weight:800;padding:.45rem .9rem;border-radius:6px;letter-spacing:.04em}
.logo-text{font-family:var(--serif);font-size:1.35rem;font-weight:800;color:var(--navy);line-height:1.1}
.logo-text span{display:block;font-size:.65rem;font-weight:500;color:var(--mid);letter-spacing:.1em;text-transform:uppercase;font-family:var(--sans)}
.hdr-nav{display:flex;align-items:center;gap:.2rem;flex:1;justify-content:center;flex-wrap:wrap}
.hn{padding:.55rem .9rem;font-size:.82rem;font-weight:500;color:#444;border-radius:6px;transition:.15s;white-space:nowrap}
.hn:hover,.hn.active{background:var(--gray);color:var(--navy)}
.hdr-ctas{display:flex;align-items:center;gap:.7rem;flex-shrink:0}
.btn-login{padding:.55rem 1.1rem;border:1.5px solid var(--border);border-radius:7px;font-size:.82rem;font-weight:600;color:var(--navy);background:#fff;transition:.2s}
.btn-login:hover{border-color:var(--navy);background:var(--gray)}
.btn-book-hdr{padding:.55rem 1.2rem;background:var(--red);color:#fff;border-radius:7px;font-size:.82rem;font-weight:700;border:none;transition:.2s}
.btn-book-hdr:hover{background:var(--red-dark)}

/* ── HERO ── */
.hero{position:relative;min-height:540px;display:flex;align-items:center;overflow:hidden;background:var(--navy)}
.hero-bg{position:absolute;inset:0;z-index:0}
.hero-bg img{width:100%;height:100%;object-fit:cover;opacity:.35}
.hero-bg::after{content:'';position:absolute;inset:0;background:linear-gradient(105deg,rgba(13,27,42,.95) 0%,rgba(13,27,42,.7) 55%,rgba(13,27,42,.25) 100%)}
.hero-inner{position:relative;z-index:2;max-width:1320px;margin:0 auto;padding:4rem 2rem;width:100%;display:grid;grid-template-columns:1fr 420px;gap:3rem;align-items:center}
.hero-copy .eyebrow{font-size:.72rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--gold2);margin-bottom:.9rem;display:flex;align-items:center;gap:.6rem}
.hero-copy .eyebrow::before{content:'';width:24px;height:2px;background:var(--gold)}
.hero-copy h1{font-family:var(--serif);font-size:3.4rem;font-weight:800;color:#fff;line-height:1.08;margin-bottom:1rem}
.hero-copy h1 em{color:var(--gold2);font-style:normal}
.hero-copy p{font-size:1rem;color:rgba(255,255,255,.78);max-width:480px;margin-bottom:2rem;font-weight:300;line-height:1.7}
.hero-badges{display:flex;gap:.8rem;flex-wrap:wrap}
.hero-badge{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(8px);padding:.45rem .9rem;border-radius:30px;font-size:.75rem;font-weight:500;color:rgba(255,255,255,.85)}

/* ── SEARCH PANEL ── */
.search-panel{background:rgba(255,255,255,.97);backdrop-filter:blur(12px);border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.22);padding:1.8rem;border:1px solid rgba(255,255,255,.6)}
.trip-toggle{display:flex;gap:.4rem;margin-bottom:1.3rem;background:var(--gray);border-radius:8px;padding:.3rem}
.trip-btn{flex:1;padding:.5rem;border:none;background:transparent;border-radius:6px;font-size:.8rem;font-weight:600;color:var(--mid);transition:.2s}
.trip-btn.active{background:#fff;color:var(--navy);box-shadow:0 2px 8px rgba(0,0,0,.08)}
.sp-row{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-bottom:.8rem}
.sp-row.three{grid-template-columns:1fr 1fr 1fr}
.sp-group{display:flex;flex-direction:column;gap:.28rem}
.sp-group label{font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--mid)}
.sp-group select,.sp-group input{width:100%;padding:.65rem .85rem;border:1.5px solid var(--border);border-radius:8px;font-size:.88rem;color:var(--text);background:#fff;outline:none;transition:.2s;appearance:none}
.sp-group select:focus,.sp-group input:focus{border-color:var(--red);box-shadow:0 0 0 3px rgba(192,57,43,.1)}
.sp-footer{display:flex;justify-content:space-between;align-items:center;margin-top:1rem;gap:.8rem}
.pax-ctrl{display:flex;align-items:center;gap:.5rem;font-size:.82rem;color:var(--mid)}
.pax-btn{width:26px;height:26px;border-radius:50%;border:1.5px solid var(--border);background:#fff;font-size:.95rem;display:flex;align-items:center;justify-content:center;transition:.15s}
.pax-btn:hover{border-color:var(--red);color:var(--red)}
.btn-search-fl{flex:1;background:var(--red);color:#fff;border:none;padding:.8rem 1.5rem;border-radius:9px;font-size:.92rem;font-weight:700;font-family:var(--serif);letter-spacing:.02em;transition:.2s;display:flex;align-items:center;justify-content:center;gap:.5rem}
.btn-search-fl:hover{background:var(--red-dark);transform:translateY(-1px)}

/* ── ROUTE RESULTS ── */
.route-results{background:var(--gray);padding:.1rem 0 2rem;display:none}
.route-results.show{display:block}
.rr-inner{max-width:1320px;margin:0 auto;padding:2rem}
.rr-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.4rem;flex-wrap:wrap;gap:.8rem}
.rr-title{font-family:var(--serif);font-size:1.4rem;font-weight:700;color:var(--navy)}
.rr-sub{font-size:.82rem;color:var(--mid)}
.flight-list{display:flex;flex-direction:column;gap:.9rem}
.flight-card{background:#fff;border-radius:12px;border:1.5px solid var(--border);padding:1.4rem 1.8rem;display:flex;align-items:center;gap:2rem;flex-wrap:wrap;transition:.2s}
.flight-card:hover{border-color:var(--red);box-shadow:0 6px 24px rgba(192,57,43,.1)}
.fl-airline{display:flex;align-items:center;gap:.6rem;flex-shrink:0;min-width:130px}
.fl-logo{background:var(--red);color:#fff;font-family:var(--serif);font-size:.75rem;font-weight:800;padding:.35rem .6rem;border-radius:5px}
.fl-name{font-size:.78rem;font-weight:600;color:var(--navy)}
.fl-cls{font-size:.68rem;color:var(--mid)}
.fl-route{display:flex;align-items:center;gap:1rem;flex:1;min-width:200px}
.fl-city{text-align:center}
.fl-time{font-family:var(--serif);font-size:1.35rem;font-weight:700;color:var(--navy);line-height:1}
.fl-code{font-size:.72rem;color:var(--mid);margin-top:.15rem}
.fl-arrow{flex:1;display:flex;flex-direction:column;align-items:center;gap:.3rem}
.fl-line{height:1.5px;background:var(--border);width:100%;position:relative}
.fl-line::after{content:'▶';position:absolute;right:-6px;top:-8px;font-size:.7rem;color:var(--mid)}
.fl-dur{font-size:.72rem;color:var(--mid)}
.fl-stops{font-size:.68rem;color:var(--green);font-weight:600}
.fl-price-block{text-align:right;flex-shrink:0;min-width:160px}
.fl-price-usd{font-family:var(--serif);font-size:1.5rem;font-weight:800;color:var(--red);line-height:1}
.fl-price-tzs{font-size:.75rem;color:var(--mid);margin-top:.1rem}
.fl-taxes{font-size:.68rem;color:var(--mid)}
.btn-select-fl{background:var(--red);color:#fff;border:none;padding:.6rem 1.4rem;border-radius:7px;font-size:.82rem;font-weight:700;margin-top:.6rem;transition:.2s;width:100%}
.btn-select-fl:hover{background:var(--red-dark)}

/* ── SECTIONS ── */
.section{padding:4.5rem 2rem}
.section-alt{padding:4.5rem 2rem;background:var(--off)}
.container{max-width:1320px;margin:0 auto}
.sec-label{font-size:.68rem;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--red);margin-bottom:.4rem;display:flex;align-items:center;gap:.5rem}
.sec-label::after{content:'';flex:1;height:1.5px;background:var(--red);opacity:.2;max-width:60px}
.sec-title{font-family:var(--serif);font-size:2.1rem;font-weight:800;color:var(--navy);line-height:1.2;margin-bottom:.5rem}
.sec-sub{font-size:.9rem;color:var(--mid);max-width:600px;line-height:1.7;margin-bottom:2.5rem}
.sec-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2rem;flex-wrap:wrap;gap:1rem}
.va{font-size:.8rem;color:var(--red);font-weight:600;border-bottom:1px dashed var(--red);transition:.15s}
.va:hover{color:var(--red-dark)}

/* ── ROUTE CARDS ── */
.routes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}
.route-card{background:#fff;border-radius:14px;overflow:hidden;border:1.5px solid var(--border);box-shadow:0 4px 16px rgba(0,0,0,.05);transition:.3s;display:flex;flex-direction:column}
.route-card:hover{transform:translateY(-6px);box-shadow:0 16px 40px rgba(0,0,0,.11);border-color:#ddd}
.rc-img{position:relative;height:190px;overflow:hidden;background:var(--navy) url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 60%22><text y=%2240%22 x=%2230%22 font-size=%2230%22>✈</text></svg>') center/60px no-repeat}
.rc-img img{width:100%;height:100%;object-fit:cover;transition:.5s}
.route-card:hover .rc-img img{transform:scale(1.07)}
.rc-type{position:absolute;top:12px;left:12px;background:var(--red);color:#fff;font-size:.67rem;font-weight:800;padding:.25rem .65rem;border-radius:20px;letter-spacing:.05em;text-transform:uppercase}
.rc-dur{position:absolute;top:12px;right:12px;background:rgba(0,0,0,.6);backdrop-filter:blur(6px);color:#fff;font-size:.7rem;font-weight:600;padding:.25rem .65rem;border-radius:20px}
.rc-body{padding:1.3rem;flex:1;display:flex;flex-direction:column}
.rc-route{display:flex;align-items:center;gap:.6rem;margin-bottom:.5rem}
.rc-from,.rc-to{font-family:var(--serif);font-size:.95rem;font-weight:700;color:var(--navy)}
.rc-arrow{color:var(--red);font-size:.85rem;flex-shrink:0}
.rc-airports{font-size:.72rem;color:var(--mid);margin-bottom:.9rem}
.rc-price-row{display:flex;justify-content:space-between;align-items:flex-end;margin-top:auto}
.rc-price-label{font-size:.68rem;color:var(--mid);text-transform:uppercase;letter-spacing:.06em}
.rc-usd{font-family:var(--serif);font-size:1.45rem;font-weight:800;color:var(--red);line-height:1}
.rc-tzs{font-size:.72rem;color:var(--mid);margin-top:.1rem}
.btn-book-rc{background:var(--navy);color:#fff;border:none;padding:.65rem 1.2rem;border-radius:8px;font-size:.8rem;font-weight:700;transition:.2s;white-space:nowrap}
.btn-book-rc:hover{background:var(--red)}

/* ── STATS ── */
.stats-band{background:var(--navy);padding:2.8rem 2rem}
.stats-inner{max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;text-align:center}
.stat-val{font-family:var(--serif);font-size:2.6rem;font-weight:800;color:var(--gold2);line-height:1;margin-bottom:.3rem}
.stat-lbl{font-size:.78rem;font-weight:500;color:rgba(255,255,255,.6);letter-spacing:.05em;text-transform:uppercase}

/* ── WHY GRID ── */
.why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem}
.why-card{background:#fff;border-radius:12px;border:1.5px solid var(--border);padding:1.8rem 1.4rem;text-align:center;transition:.25s}
.why-card:hover{border-color:var(--red);box-shadow:0 8px 24px rgba(192,57,43,.1);transform:translateY(-4px)}
.wc-icon{width:54px;height:54px;background:linear-gradient(135deg,var(--red),var(--red2));border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin:0 auto 1rem}
.wc-title{font-family:var(--serif);font-size:1rem;font-weight:700;color:var(--navy);margin-bottom:.4rem}
.wc-desc{font-size:.8rem;color:var(--mid);line-height:1.6}

/* ── DESTINATIONS SHOWCASE ── */
.dest-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}
.dest-tile{border-radius:12px;overflow:hidden;position:relative;aspect-ratio:.85;cursor:pointer;transition:.28s}
.dest-tile:hover{transform:translateY(-5px);box-shadow:0 14px 36px rgba(0,0,0,.18)}
.dest-tile img{width:100%;height:100%;object-fit:cover;transition:.5s;background:var(--navy2)}
.dest-tile:hover img{transform:scale(1.07)}
.dt-overlay{position:absolute;inset:0;background:linear-gradient(transparent 30%,rgba(10,20,35,.82) 100%)}
.dt-body{position:absolute;bottom:0;left:0;right:0;padding:1.1rem}
.dt-code{font-size:.68rem;font-weight:700;letter-spacing:.12em;color:var(--gold2);text-transform:uppercase;margin-bottom:.2rem}
.dt-name{font-family:var(--serif);font-size:1.15rem;font-weight:700;color:#fff}
.dt-type{font-size:.72rem;color:rgba(255,255,255,.7)}

/* ── BOOKING MODAL OVERLAY ── */
.modal-bg{display:none;position:fixed;inset:0;background:rgba(10,20,35,.72);z-index:900;justify-content:center;align-items:flex-start;padding:1.5rem;overflow-y:auto;backdrop-filter:blur(4px)}
.modal-bg.open{display:flex}
.modal{background:#fff;border-radius:18px;width:100%;max-width:860px;box-shadow:0 30px 80px rgba(0,0,0,.3);overflow:hidden;animation:slideUp .35s ease}
@keyframes slideUp{from{transform:translateY(40px);opacity:0}to{transform:translateY(0);opacity:1}}

/* Modal steps */
.m-head{background:linear-gradient(135deg,var(--navy),var(--navy2));color:#fff;padding:1.6rem 2rem;display:flex;justify-content:space-between;align-items:flex-start}
.m-head-left h2{font-family:var(--serif);font-size:1.3rem;font-weight:800;margin-bottom:.15rem}
.m-head-left p{font-size:.8rem;opacity:.7}
.m-close{background:rgba(255,255,255,.12);border:none;color:#fff;width:34px;height:34px;border-radius:50%;font-size:1.2rem;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:.2s}
.m-close:hover{background:rgba(255,255,255,.25)}
.m-steps{display:flex;background:var(--gray);border-bottom:1.5px solid var(--border)}
.m-step{flex:1;padding:.9rem .5rem;text-align:center;font-size:.75rem;font-weight:600;color:var(--mid);border-bottom:2.5px solid transparent;transition:.2s;cursor:default}
.m-step.active{color:var(--red);border-bottom-color:var(--red)}
.m-step.done{color:var(--green)}
.m-step span{display:block;font-size:.68rem;font-weight:400;margin-top:.1rem;opacity:.7}
.m-body{padding:2rem}
.step-section{display:none}
.step-section.show{display:block}

/* Step 1 — Flight summary */
.flight-summary{background:var(--off);border-radius:10px;padding:1.2rem;margin-bottom:1.5rem;border:1px solid var(--border)}
.fs-route{display:flex;align-items:center;gap:1rem;margin-bottom:.8rem;flex-wrap:wrap}
.fs-city{font-family:var(--serif);font-size:1.1rem;font-weight:700;color:var(--navy)}
.fs-arrow{color:var(--red);font-size:1.2rem}
.fs-details{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem}
.fs-item label{font-size:.65rem;text-transform:uppercase;letter-spacing:.1em;color:var(--mid);font-weight:700;display:block;margin-bottom:.15rem}
.fs-item span{font-size:.88rem;font-weight:600;color:var(--navy)}
.fs-price-row{display:flex;justify-content:space-between;align-items:center;margin-top:1rem;padding-top:.8rem;border-top:1px dashed var(--border)}
.fs-total-label{font-size:.8rem;color:var(--mid)}
.fs-total-usd{font-family:var(--serif);font-size:1.6rem;font-weight:800;color:var(--red)}
.fs-total-tzs{font-size:.78rem;color:var(--mid);margin-top:.1rem}

/* Seat map */
.seat-legend{display:flex;gap:1.2rem;flex-wrap:wrap;margin-bottom:1rem;font-size:.75rem;color:var(--mid)}
.sl-item{display:flex;align-items:center;gap:.4rem}
.sl-box{width:16px;height:16px;border-radius:3px;border:1.5px solid}
.sl-box.avail{background:#fff;border-color:var(--navy)}
.sl-box.sel{background:var(--red);border-color:var(--red)}
.sl-box.occ{background:#d0d5dd;border-color:#bbb}
.sl-box.biz{background:var(--gold2);border-color:var(--gold)}
.seat-plane{background:var(--off);border-radius:12px;padding:1.4rem;margin-bottom:1rem;overflow-x:auto}
.plane-nose{text-align:center;font-size:1.6rem;margin-bottom:.5rem;opacity:.5}
.plane-label{display:flex;justify-content:flex-end;font-size:.65rem;color:var(--mid);margin-bottom:.5rem;padding-right:.5rem;letter-spacing:.05em}
.seat-rows{display:flex;flex-direction:column;gap:.4rem}
.seat-row{display:flex;align-items:center;gap:.35rem;justify-content:center}
.row-num{width:22px;font-size:.68rem;color:var(--mid);text-align:right;flex-shrink:0}
.aisle{width:20px;flex-shrink:0}
.seat{width:36px;height:36px;border-radius:6px 6px 4px 4px;border:1.5px solid var(--navy);background:#fff;color:var(--navy);font-size:.68rem;font-weight:700;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:.15s;flex-shrink:0;user-select:none}
.seat.biz{border-color:var(--gold);background:#fffbea;color:var(--navy);width:40px;height:40px}
.seat:hover:not(.occ){transform:scale(1.12);box-shadow:0 2px 8px rgba(192,57,43,.25)}
.seat.sel{background:var(--red);border-color:var(--red);color:#fff}
.seat.occ{background:#e9ecef;border-color:#ccc;color:#aaa;cursor:not-allowed}
.seat-note{font-size:.75rem;color:var(--mid);text-align:center;margin-top:.5rem}

/* Passenger form */
.pax-section{margin-bottom:1.5rem}
.pax-title{font-family:var(--serif);font-size:1rem;font-weight:700;color:var(--navy);border-bottom:1.5px solid var(--border);padding-bottom:.6rem;margin-bottom:1rem;display:flex;align-items:center;gap:.5rem}
.pax-num{background:var(--red);color:#fff;width:22px;height:22px;border-radius:50%;font-size:.72rem;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:.9rem}
.form-grid.three{grid-template-columns:1fr 1fr 1fr}
.fg{display:flex;flex-direction:column;gap:.28rem}
.fg label{font-size:.72rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--mid)}
.fg input,.fg select{padding:.68rem .9rem;border:1.5px solid var(--border);border-radius:8px;font-size:.88rem;color:var(--text);background:#fff;outline:none;transition:.2s}
.fg input:focus,.fg select:focus{border-color:var(--red);box-shadow:0 0 0 3px rgba(192,57,43,.1)}

/* Review */
.review-block{background:var(--off);border-radius:10px;padding:1.3rem;border:1px solid var(--border);margin-bottom:1rem}
.rb-title{font-size:.75rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--mid);margin-bottom:.9rem}
.rb-row{display:flex;justify-content:space-between;padding:.3rem 0;font-size:.85rem;border-bottom:1px dashed #e3e7ee}
.rb-row:last-child{border:none;font-weight:700;font-size:.95rem;padding-top:.6rem;margin-top:.2rem}
.rb-row .val{color:var(--navy);font-weight:600}
.rb-row.total .val{color:var(--red);font-size:1.1rem;font-weight:800}
.rb-row.total{border-top:2px dashed var(--red);margin-top:.5rem;padding-top:.7rem}

