function buildReview(){
  const rt = modalTripType === 'rt';
  const ecoPrice = currentRoute.eco * modalPaxCount * (rt?2:1);
  const bizPrice = currentRoute.biz * modalPaxCount * (rt?2:1);
  const price = selectedClass === 'eco' ? ecoPrice : bizPrice;
  const cls = selectedClass === 'eco' ? 'Economy' : 'Business';

  // collect passenger names
  const paxLines = [];
  for(let i=0;i<modalPaxCount;i++){
    const t = document.getElementById(`p${i}title`)?.value||'';
    const fn = document.getElementById(`p${i}fn`)?.value||'';
    const ln = document.getElementById(`p${i}ln`)?.value||'';
    if(fn||ln) paxLines.push(`${t} ${fn} ${ln}`.trim());
  }
  const phone = document.getElementById('paxPhone')?.value||'';
  const email = document.getElementById('paxEmail')?.value||'';
  const dep   = document.getElementById('mDep')?.value||document.getElementById('sDep')?.value||'';
  const ret   = document.getElementById('mRet')?.value||'';

  function fmtDate(d){
    if(!d) return 'To be confirmed';
    const dt = new Date(d+'T00:00:00');
    return dt.toLocaleDateString('en-GB',{weekday:'short',day:'2-digit',month:'short',year:'numeric'});
  }

  document.getElementById('reviewBlock').innerHTML = `
    <div class="rb-title">Booking Summary</div>
    <div class="rb-row"><span>Route</span><span class="val">${currentRoute.fromName} (${currentRoute.from}) → ${currentRoute.toName} (${currentRoute.to})</span></div>
    <div class="rb-row"><span>Trip Type</span><span class="val">${rt?'Round Trip ⇄':'One Way →'} · ${currentRoute.type}</span></div>
    <div class="rb-row"><span>Departure</span><span class="val">${fmtDate(dep)}</span></div>
    ${rt?`<div class="rb-row"><span>Return</span><span class="val">${fmtDate(ret)}</span></div>`:''}
    <div class="rb-row"><span>Duration</span><span class="val">${currentRoute.duration}</span></div>
    <div class="rb-row"><span>Fare Class</span><span class="val">${cls}</span></div>
    <div class="rb-row"><span>Seats</span><span class="val">${selectedSeats.join(', ')||'Not selected'}</span></div>
    <div class="rb-row"><span>Passengers</span><span class="val">${paxLines.join(' | ')||modalPaxCount+' passenger(s)'}</span></div>
    <div class="rb-row"><span>Contact</span><span class="val">${phone||'—'}</span></div>
    ${email?`<div class="rb-row"><span>Email</span><span class="val">${email}</span></div>`:''}
    <div class="rb-row total"><span>Total Fare (${modalPaxCount} pax${rt?' · RT':''})</span><span class="val">${fmt(price)}<br/><small style="font-weight:400;font-size:.72rem">${fmtTZS(price)}</small></span></div>`;
}

// ─── MODAL-LOCAL TRIP / PAX ───
let modalTripType = 'ow';
let modalPaxCount = 1;

function setModalTrip(t){
  modalTripType = t;
  const owBtn = document.getElementById('mOwBtn');
  const rtBtn = document.getElementById('mRtBtn');
