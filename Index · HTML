    <label style="border:2px solid var(--red);background:#fff7f6;border-radius:10px;padding:1.2rem;cursor:pointer;position:relative" id="ecoCard">
      <input type="radio" name="fareClass" value="eco" checked style="display:none" onchange="setClass('eco')"/>
      <div style="font-size:.68rem;font-weight:800;letter-spacing:.1em;color:var(--mid);text-transform:uppercase;margin-bottom:.3rem">Economy${rtTag}</div>
      <div style="font-family:var(--serif);font-size:1.6rem;font-weight:800;color:var(--red);line-height:1">${fmt(ecoTotal)}</div>
      <div style="font-size:.72rem;color:var(--mid);margin-top:.1rem">${fmtTZS(ecoTotal)} · ${modalPaxCount} pax</div>
      <div style="font-size:.72rem;color:#555;margin-top:.5rem">23kg baggage · 7kg cabin · Meals on select routes</div>
      <div style="position:absolute;top:10px;right:10px;background:var(--red);color:#fff;border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:.75rem" id="ecoCheck">✓</div>
    </label>
    <label style="border:2px solid var(--border);background:#fff;border-radius:10px;padding:1.2rem;cursor:pointer;position:relative" id="bizCard">
      <input type="radio" name="fareClass" value="biz" style="display:none" onchange="setClass('biz')"/>
      <div style="font-size:.68rem;font-weight:800;letter-spacing:.1em;color:var(--gold);text-transform:uppercase;margin-bottom:.3rem">Business${rtTag}</div>
      <div style="font-family:var(--serif);font-size:1.6rem;font-weight:800;color:var(--navy);line-height:1">${fmt(bizTotal)}</div>
      <div style="font-size:.72rem;color:var(--mid);margin-top:.1rem">${fmtTZS(bizTotal)} · ${modalPaxCount} pax</div>
      <div style="font-size:.72rem;color:#555;margin-top:.5rem">Priority boarding · Extra legroom · Premium meals</div>
      <div style="position:absolute;top:10px;right:10px;background:var(--border);color:transparent;border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:.75rem" id="bizCheck">✓</div>
    </label>`;
  selectedClass = 'eco';
}

// ─── OPEN MODAL ───
function openModal(route){
  if(route) currentRoute = route;
  if(!currentRoute) currentRoute = ROUTES[0];
  currentStep = 1;
  selectedSeats = [];
  selectedClass = 'eco';
  modalTripType = 'ow';
  modalPaxCount = 1;

  // Init date inputs
  const todayStr = new Date().toISOString().split('T')[0];
  const mDep = document.getElementById('mDep');
  const mRet = document.getElementById('mRet');
  if(mDep){ mDep.min = todayStr; mDep.value = todayStr; }
  if(mRet){ mRet.min = todayStr; mRet.value = ''; }

  // Reset modal-local UI
  setModalTrip('ow');
  document.getElementById('mPaxDisplay').textContent = '1';

  // Flight summary
  document.getElementById('mFlightSummary').innerHTML = `
    <div class="fs-route">
      <div class="fs-city">${currentRoute.fromName} <span style="font-size:.72rem;color:var(--mid)">(${currentRoute.from})</span></div>
      <div class="fs-arrow">→</div>
      <div class="fs-city">${currentRoute.toName} <span style="font-size:.72rem;color:var(--mid)">(${currentRoute.to})</span></div>
    </div>
    <div class="fs-details">
      <div class="fs-item"><label>Type</label><span>${currentRoute.type}</span></div>
      <div class="fs-item"><label>Duration</label><span>${currentRoute.duration}</span></div>
      <div class="fs-item"><label>Daily Flights</label><span>${currentRoute.dep.length} times</span></div>
      <div class="fs-item"><label>Direct</label><span>Yes ✓</span></div>
    </div>`;

  refreshClassCards();

  document.getElementById('mTitle').textContent = `Book: ${currentRoute.fromName} → ${currentRoute.toName}`;
  document.getElementById('mSub').textContent = `${currentRoute.type} · ${currentRoute.duration} · 1 passenger(s)`;
  gotoStep(1);
  document.getElementById('modalBg').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function setClass(c){
  selectedClass = c;
  const ecoCard = document.getElementById('ecoCard');
  const bizCard = document.getElementById('bizCard');
  const ecoCheck = document.getElementById('ecoCheck');
  const bizCheck = document.getElementById('bizCheck');
  if(c==='eco'){
    ecoCard.style.border='2px solid var(--red)'; ecoCard.style.background='#fff7f6';
    bizCard.style.border='2px solid var(--border)'; bizCard.style.background='#fff';
    ecoCheck.style.background='var(--red)'; ecoCheck.style.color='#fff';
    bizCheck.style.background='var(--border)'; bizCheck.style.color='transparent';
  } else {
    bizCard.style.border='2px solid var(--gold)'; bizCard.style.background='#fffbea';
    ecoCard.style.border='2px solid var(--border)'; ecoCard.style.background='#fff';
    bizCheck.style.background='var(--gold)'; bizCheck.style.color='var(--navy)';
    ecoCheck.style.background='var(--border)'; ecoCheck.style.color='transparent';
  }
}

function closeModal(){
  document.getElementById('modalBg').classList.remove('open');
  document.body.style.overflow = '';
}

function handleBgClick(e){ if(e.target.id==='modalBg') closeModal(); }

function gotoStep(n){
  currentStep = n;
  for(let i=1;i<=4;i++){
    document.getElementById(`step${i}`).classList.toggle('show', i===n);
    const ms = document.getElementById(`mStep${i}`);
    ms.classList.remove('active','done');
    if(i===n) ms.classList.add('active');
    else if(i<n) ms.classList.add('done');
  }
  document.getElementById('prevBtn').style.display = n===1?'none':'flex';
  document.getElementById('nextBtn').textContent = n===4?'Confirm':'Continue →';
  document.getElementById('nextBtn').onclick = n===4 ? confirmBooking : nextStep;

  if(n===2){ buildSeatMap(); document.getElementById('seatsNeeded').textContent=modalPaxCount; }
  if(n===3) buildPassengerForms();
  if(n===4) buildReview();
}

function nextStep(){
  if(currentStep===2 && selectedSeats.length < modalPaxCount){
    showToast(`Please select ${modalPaxCount} seat(s). You have ${selectedSeats.length}.`); return;
  }
  if(currentStep===3){
    for(let i=0;i<modalPaxCount;i++){
      if(!document.getElementById(`p${i}fn`)?.value.trim()||!document.getElementById(`p${i}ln`)?.value.trim()){
        showToast(`Please enter full name for Passenger ${i+1}.`); return;
      }
    }
    if(!document.getElementById('paxPhone')?.value.trim()){
      showToast('Please enter a contact phone number.'); return;
    }
  }
  if(currentStep < 4) gotoStep(currentStep+1);
}

function prevStep(){ if(currentStep > 1) gotoStep(currentStep-1); }

// ─── CONFIRM BOOKING → WHATSAPP ───
function confirmBooking(){
  var pricePerPax = selectedClass==="eco" ? currentRoute.eco : currentRoute.biz;
  var rt = modalTripType==="rt";
  var totalUSD = pricePerPax * modalPaxCount * (rt ? 2 : 1);
  var cls = selectedClass==="eco" ? "Economy" : "Business Class";
  var SEP = "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500";

  var paxData = [];
  for(var i=0;i<modalPaxCount;i++){
    var el = function(id){ var e=document.getElementById(id); return e?e.value:""; };
    paxData.push({title:el("p"+i+"title")||"Mr",fn:el("p"+i+"fn"),ln:el("p"+i+"ln"),dob:el("p"+i+"dob"),pass:el("p"+i+"pass"),nat:el("p"+i+"nat"),exp:el("p"+i+"exp")});
  }
  var phone = (document.getElementById("paxPhone")||{value:""}).value;
  var email = (document.getElementById("paxEmail")||{value:""}).value;
  var dep   = (document.getElementById("mDep")||document.getElementById("sDep")||{value:""}).value;
  var ret   = (document.getElementById("mRet")||{value:""}).value;

  function fmtDate(d){
    if(!d) return "To be confirmed";
    var dt = new Date(d+"T00:00:00");
    return dt.toLocaleDateString("en-GB",{weekday:"short",day:"2-digit",month:"short",year:"numeric"});
  }

  var ref = "PW-" + Math.random().toString(36).slice(2,8).toUpperCase();
  var now = new Date().toLocaleString("en-GB",{day:"2-digit",month:"short",year:"numeric",hour:"2-digit",minute:"2-digit",hour12:false});
  var lead = paxData[0];
  var leadName = (lead.title+" "+lead.fn+" "+lead.ln).trim().toUpperCase();

  var allPaxBlock = "";
  paxData.forEach(function(p,i){
    var name = (p.title+" "+p.fn+" "+p.ln).trim().toUpperCase();
    var seat = selectedSeats[i] || "To be assigned";
    allPaxBlock +=
      "  PAX "+(i+1)+" \u2014 "+(i===0?"Adult (LEAD)":"Adult")+"\n"+
      "  Name       : "+name+"\n"+
      (p.dob  ? "  DOB        : "+p.dob+"\n" : "")+
      (p.nat  ? "  Nationality: "+p.nat+"\n" : "")+
      (p.pass ? "  Passport   : "+p.pass+"\n" : "")+
      (p.exp  ? "  Expiry     : "+p.exp+"\n" : "")+
      "  "+(rt?"Outbound ":"")+"Seat: "+seat+"\n"+
      (rt?"  Return Seat : To be assigned\n":"")+
      SEP+"\n";
  });

  var rtLabel = rt ? " x2 (Round Trip)" : "";
  var ticketURL = "https://precisionairtz.site/ticket?ref="+ref;

  var msg =
    "\u2705 *PRECISION AIR \u2014 BOOKING REQUEST*\n"+SEP+"\n"+
    "📋 *Booking Ref:* "+ref+"\n"+
    "🕐 *Time:* "+now+"\n"+
    "📞 *Contact No.:* "+(phone||"\u2014")+"\n"+
    "🏦 *Agent:* +254 103 761 442 (Precision Air TZ)\n"+
    "💵 *Total Fare:* USD "+totalUSD+"\n"+
    SEP+"\n"+
    "\u2708 *FLIGHT DETAILS*\n"+SEP+"\n"+
    "Route     : "+currentRoute.fromName+" ("+currentRoute.from+")  \u2708  "+currentRoute.toName+" ("+currentRoute.to+")\n"+
    "Trip Type : "+(rt?"Round Trip \u21c4":"One Way \u2192")+"\n"+
    "Departure : "+fmtDate(dep)+"\n"+
    (rt?"Return    : "+fmtDate(ret)+"\n":"")+
    "Airline   : Precision Air (PW)\n"+
    "Cabin     : "+cls+"\n"+
    "Duration  : "+currentRoute.duration+"\n"+
    "Baggage   : 23kg checked + 7kg cabin\n"+
    "Meal      : Standard meal\n"+
    (rt?"Outbound Seat(s): ":(selectedSeats.length?"Seat(s)   : ":"Seat(s)   : "))+(selectedSeats.join(", ")||"To be assigned")+"\n"+
    SEP+"\n"+
    "👤 *LEAD PASSENGER*\n"+SEP+"\n"+
    "Name        : "+leadName+"\n"+
    "WhatsApp    : "+(phone||"\u2014")+"\n"+
    "Email       : "+(email||"\u2014")+"\n"+
    "Nationality : "+(lead.nat||"\u2014")+"\n"+
    "Passport    : "+(lead.pass||"\u2014")+"\n"+
    (lead.exp?"Passport Expiry: "+lead.exp+"\n":"")+
    SEP+"\n"+
    "🧳 *ALL PASSENGERS ("+modalPaxCount+" total)*\n"+SEP+"\n"+
    allPaxBlock+
    "💰 *FARE BREAKDOWN*\n"+SEP+"\n"+
    "Adults ("+modalPaxCount+") : USD "+pricePerPax+" x "+modalPaxCount+rtLabel+"\n"+
    "*TOTAL : USD "+totalUSD+"*\n"+
    "TZS Equiv : TZS "+(totalUSD*TZS_RATE).toLocaleString()+"\n"+
    SEP+"\n"+
    "🎫 *BOARDING PASS / TICKET*\n"+SEP+"\n"+
    "Booking Ref: "+ref+"\n"+
    "Booking portal: "+ticketURL+"\n"+
    SEP+"\n"+
    "_Please confirm payment receipt and issue e-ticket. Thank you!_ 🙏";

  window.open("https://wa.me/254103761442?text="+encodeURIComponent(msg),"_blank");
  showToast("Opening WhatsApp \u2014 booking sent!");
  closeModal();
}
// ─── TOAST ───
function showToast(m){
  const t = document.getElementById('toast');
  t.textContent = m;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 3000);
}

// ─── INIT ───
renderRoutes();
// Set min date to today
const today = new Date().toISOString().split('T')[0];
document.getElementById('sDep').min = today;
document.getElementById('sRet').min = today;
document.getElementById('sDep').value = today;
</script>
