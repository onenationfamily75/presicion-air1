function changePax(d){
  paxCount = Math.max(1, Math.min(9, paxCount + d));
  document.getElementById('paxCount').textContent = paxCount;
}

// ─── SEARCH ───
// Airport name lookup
const AIRPORT_NAMES = {
  DAR:'Dar es Salaam', ZNZ:'Zanzibar', JRO:'Kilimanjaro',
  ARK:'Arusha', MWZ:'Mwanza', MYW:'Mtwara', DOD:'Dodoma',
  BKZ:'Bukoba', NBO:'Nairobi', EBB:'Entebbe'
};

// Default departure times and base prices when no exact route exists
const DEF_DEPS = ['06:30','08:00','10:30','13:00','15:30','17:00'];
const DEF_PRICES = {
  domestic:{eco:119,biz:229,dur:'1h 00min'},
  regional:{eco:179,biz:339,dur:'1h 30min'},
  international:{eco:219,biz:409,dur:'2h 00min'}
};

function getRouteType(from, to){
  const intl = ['NBO','EBB'];
  if(intl.includes(from)||intl.includes(to)) return 'international';
  return 'domestic';
}

function buildFlightCard(r, t){
  const flightNum = `PW ${(parseInt(r.from.charCodeAt(0)) + parseInt(r.to.charCodeAt(0)) + DEF_DEPS.indexOf(t||r.dep[0])*10 + 100) % 900 + 100}`;
  return `
    <div class="flight-card">
      <div class="fl-airline">
        <div>
          <div class="fl-logo">PW</div>
          <div class="fl-name" style="margin-top:.3rem">Precision Air</div>
          <div class="fl-cls">${flightNum}</div>
        </div>
      </div>
      <div class="fl-route">
        <div class="fl-city">
          <div class="fl-time">${t}</div>
          <div class="fl-code">${r.from}</div>
        </div>
        <div class="fl-arrow">
          <div class="fl-line"></div>
          <div class="fl-dur">${r.duration}</div>
          <div class="fl-stops">Direct</div>
        </div>
        <div class="fl-city">
          <div class="fl-time">${addDur(t, r.duration)}</div>
          <div class="fl-code">${r.to}</div>
        </div>
      </div>
      <div class="fl-price-block">
        <div class="fl-price-usd">${fmt(r.eco * paxCount)}</div>
        <div class="fl-price-tzs">${fmtTZS(r.eco * paxCount)}</div>
        <div class="fl-taxes">Economy · incl. taxes · ${paxCount} pax</div>
        <button class="btn-select-fl" onclick='openModal(${JSON.stringify(r)})'>Select →</button>
      </div>
    </div>`;
}

function searchFlights(){
  const from = document.getElementById('sFrom').value;
  const to   = document.getElementById('sTo').value;
  const dep  = document.getElementById('sDep').value;
  if(!from||!to){ showToast('Please select origin and destination.'); return; }
  if(from===to){ showToast('Origin and destination cannot be the same.'); return; }
  if(!dep){ showToast('Please select a departure date.'); return; }

  const res  = document.getElementById('flightResults');
  const list = document.getElementById('flightList');
  const depDate = new Date(dep).toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short',year:'numeric'});

  // Try exact route match first
  let matches = ROUTES.filter(r => r.from===from && r.to===to);

  // If no exact match, generate flights dynamically so all routes are always available
  if(!matches.length){
    const rType = getRouteType(from, to);
    const defaults = DEF_PRICES[rType];
    const synth = {
      from, to,
      fromName: AIRPORT_NAMES[from]||from,
      toName:   AIRPORT_NAMES[to]||to,
      code: `${from}-${to}`,
      duration: defaults.dur,
      type: rType==='international'?'International':'Domestic',
      eco:  defaults.eco,
      biz:  defaults.biz,
      dep:  DEF_DEPS,
      img:  'https://images.unsplash.com/photo-1436491865332-7a61a109cc05?w=700&q=80'
    };
    matches = [synth];
  }

  list.innerHTML = matches.flatMap(r =>
    r.dep.map(t => buildFlightCard(r, t))
  ).join('');

  document.getElementById('rrTitle').textContent =
    `${AIRPORT_NAMES[from]||from} → ${AIRPORT_NAMES[to]||to}`;
  document.getElementById('rrSub').textContent =
    `${depDate} · ${paxCount} passenger(s) · ${tripType==='rt'?'Round Trip':'One Way'}`;
  res.classList.add('show');
  res.scrollIntoView({behavior:'smooth', block:'start'});
}

function addDur(time, dur){
  const [h,m] = time.split(':').map(Number);
  const mins = parseInt(dur)*60 + (dur.includes('h ')?parseInt(dur.split('h ')[1]):0);
  const total = h*60 + m + mins;
  return `${String(Math.floor(total/60)%24).padStart(2,'0')}:${String(total%60).padStart(2,'0')}`;
}

